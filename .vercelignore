# Files Vercel should never upload/build/bundle (see DEPLOY_VERCEL.md).
# The phone app is not hosted: Vercel serves only the Sekisho server
# (api/index.py) and public/robots.txt. The app ships inside the APK.
app/
node_modules
**/*.tsbuildinfo

# Python virtualenvs / caches
server/.venv
.venv
**/__pycache__
**/*.pyc

# Local data — never ship a SQLite database or its WAL files
*.db
*.db-shm
*.db-wal
*.sqlite
*.log
.env
.env.*

# Tests + Docker-only tooling (not needed by the function)
server/tests_smoke.py
**/tests
**/test_*.py
server/tools
server/docker
server/nginx
server/Dockerfile
server/docker-entrypoint.sh
*.zip
