{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"server only: no web app to install\"",
  "buildCommand": "echo \"server only: no web app to build\"",
  "outputDirectory": "public",
  "fluid": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "server/sekisho/**",
      "excludeFiles": "{app/**,node_modules/**,server/.venv/**,server/tools/**,server/docker/**,server/nginx/**,server/tests_smoke.py,server/*.db*,**/__pycache__/**,**/*.db,**/*.zip,.github/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/admin", "destination": "/api/index" },
    { "source": "/admin/(.*)", "destination": "/api/index" },
    { "source": "/pair/(.*)", "destination": "/api/index" },
    { "source": "/llm/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/tick", "schedule": "0 13 * * *" }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
