# deps / build outputs
node_modules/
app/dist/
app/dev-dist/
*.tsbuildinfo

# python
server/.venv/
__pycache__/
*.pyc

# data / secrets — never commit user data or keys
*.db
*.db-shm
*.db-wal
*.log
.env
.env.*
server/nginx/certs/
